@@ -265,6 +287,127 @@ static void *ob_cuvs_raw_batch_job(void *arg) {
 
 static const size_t OB_CUVS_MIN_PTS = 256;  // CAGRA needs a graph; below this -> VSAG
 
+// ==== [contest] idle-triggered background CAGRA build ======================
+// On this baseline the GPU graph is still built at the very end of the DDL (in
+// ob_cuvs_serialize), i.e. strictly after the CPU-bound VSAG construction has
+// finished, so the GPU stays idle for the whole load and its build time is pure
+// added latency.  The watcher below starts the CAGRA build as soon as the
+// buffered vectors stop growing for a short while (or on geometric growth),
+// while the loader is still inserting into VSAG.  The serialize step then finds
+// a ready graph and the first query does not pay for it either.
+//
+// Safety:
+//  * the build reads buf_vecs_ only with g_ob_cuvs_mu held, so it can never see
+//    a reallocated buffer, and concurrent searches never see a half-built graph;
+//  * the entry is re-looked-up under the lock on every step, so dropping an
+//    index simply stops the watcher (no dangling pointer, no use-after-free);
+//  * serving still requires built_n_ == buf_ids_.size() (baseline guard), so a
+//    stale graph is never used for results;
+//  * OB_CUVS_EAGER=0 disables everything here and restores baseline behaviour.
+static inline bool ob_cuvs_eager_enabled() {
+  static const bool enabled = []() {
+    const char *e = ::getenv("OB_CUVS_EAGER");
+    return !(e != nullptr && e[0] == '0');
+  }();
+  return enabled;
+}
+static inline int64_t ob_cuvs_env_ms(const char *name, int64_t def_val) {
+  const char *e = ::getenv(name);
+  if (e == nullptr || e[0] == '\0') { return def_val; }
+  const int64_t v = ::atoll(e);
+  return v > 0 ? v : def_val;
+}
+struct ObCuvsWatchArg {
+  void *key_;
+};
+static void *ob_cuvs_watch_job(void *arg) {
+  void *key = static_cast<ObCuvsWatchArg *>(arg)->key_;
+  ::free(arg);
+  const int64_t settle_ms = ob_cuvs_env_ms("OB_CUVS_SETTLE_MS", 300);
+  const int64_t final_ms = ob_cuvs_env_ms("OB_CUVS_FINAL_MS", 500);
+  while (true) {
+    ::usleep(50 * 1000);
+    bool build_now = false;
+    bool stop = false;
+    {
+      std::lock_guard<std::mutex> guard(g_ob_cuvs_mu);
+      auto it = g_ob_cuvs_reg.find(key);
+      if (it == g_ob_cuvs_reg.end()) {
+        stop = true;  // index dropped while watching
+      } else {
+        ObCuvsEntry *ent = it->second;
+        const size_t n = ent->buf_ids_.size();
+        const int64_t idle_ms =
+            ObTimeUtility::current_time() / 1000 - ent->last_add_ms_;
+        if (ent->dim_ > 0 && n >= OB_CUVS_MIN_PTS && n > ent->built_n_) {
+          // geometric growth is worth a speculative build while loading; the
+          // smaller tail is only built once the loader looks quiescent
+          const bool geometric = (ent->built_n_ == 0 || n >= ent->built_n_ * 2);
+          if (idle_ms >= (geometric ? settle_ms : final_ms)) { build_now = true; }
+        } else if (idle_ms > final_ms * 4) {
+          stop = true;  // graph current and loader quiet: nothing left to watch
+        }
+      }
+    }
+    if (build_now) {
+      std::lock_guard<std::mutex> guard(g_ob_cuvs_mu);
+      auto it = g_ob_cuvs_reg.find(key);
+      if (it == g_ob_cuvs_reg.end()) { break; }
+      ObCuvsEntry *ent = it->second;
+      const size_t n = ent->buf_ids_.size();
+      if (ent->dim_ > 0 && n >= OB_CUVS_MIN_PTS && n > ent->built_n_ &&
+          ent->buf_vecs_.size() == n * static_cast<size_t>(ent->dim_)) {
+        std::shared_ptr<void> nb = ob_cuvs_build_big_stack(
+            ent->buf_vecs_.data(), static_cast<long>(n), ent->dim_);
+        if (nb != nullptr) {
+          ent->bridge_ = nb;
+          ent->built_n_ = n;
+          ent->ids_ = ent->buf_ids_;
+          ob_vsag_trace("cuvs_async_build", key, static_cast<long>(n), 0);
+        }
+      }
+    } else if (stop) {
+      break;
+    }
+  }
+  {
+    std::lock_guard<std::mutex> guard(g_ob_cuvs_mu);
+    auto it = g_ob_cuvs_reg.find(key);
+    if (it != g_ob_cuvs_reg.end()) { it->second->watch_inflight_ = false; }
+  }
+  return nullptr;
+}
+// Caller must hold g_ob_cuvs_mu (ob_cuvs_add does).
+static void ob_cuvs_start_watcher(void *key) {
+  if (key == nullptr || !ob_cuvs_enabled() || !ob_cuvs_eager_enabled()) { return; }
+  auto it = g_ob_cuvs_reg.find(key);
+  if (it == g_ob_cuvs_reg.end()) { return; }
+  ObCuvsEntry *ent = it->second;
+  if (ent->watch_inflight_ || ent->dim_ <= 0) { return; }
+  if (ent->buf_ids_.size() < OB_CUVS_MIN_PTS) { return; }
+  // Only kick a speculative rebuild on geometric growth; the tail is handled by
+  // the already-running watcher when the loader goes quiet.
+  if (ent->built_n_ != 0 && ent->buf_ids_.size() < ent->built_n_ * 2) { return; }
+  ObCuvsWatchArg *arg =
+      static_cast<ObCuvsWatchArg *>(::malloc(sizeof(ObCuvsWatchArg)));
+  if (arg == nullptr) { return; }
+  arg->key_ = key;
+  ent->watch_inflight_ = true;
+  pthread_t tid;
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  // cuVS needs a stack far larger than an OB worker thread's (~1.5MB).
+  pthread_attr_setstacksize(&attr, 32UL * 1024 * 1024);
+  if (pthread_create(&tid, &attr, ob_cuvs_watch_job, arg) == 0) {
+    pthread_detach(tid);
+  } else {
+    ::free(arg);
+    ent->watch_inflight_ = false;
+  }
+  pthread_attr_destroy(&attr);
+}
+// ==== end contest idle build ==============================================
