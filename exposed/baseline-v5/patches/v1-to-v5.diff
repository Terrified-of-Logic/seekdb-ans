+  while (bytes > 0) {
+    const size_t sz = bytes < CHUNK ? bytes : CHUNK;
+    in.read(p, static_cast<std::streamsize>(sz));
+    if (in.gcount() != static_cast<std::streamsize>(sz)) { return false; }
+    p += sz; bytes -= sz;
