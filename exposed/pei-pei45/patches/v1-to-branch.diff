+// A deferred index (see ob_cuvs_take_defer) has no CPU graph, which is fine while
+// cuVS answers the query. The moment cuVS is not allowed to -- a restricted
+// pre-filter, or a stale GPU build -- the VSAG fallback below would search an
+// empty index and the caller would see zero rows. Every row is still in
+// buf_vecs_/buf_ids_, so rebuild the CPU graph from that buffer here: one bulk
+// Add, once per index. Afterwards vsag_materialized_ stops the deferral so later
+// inserts keep both graphs consistent.
+static std::mutex g_ob_cuvs_mat_mu;
+static int ob_cuvs_materialize(void *key, HnswIndexHandler *hnsw)
+{
+  int ret = OB_SUCCESS;
+  std::vector<float> vecs;
+  std::vector<int64_t> ids;
+  int64_t dim = 0;
+  {
+    // Serialise materialisation: two queries may need the graph at the same time.
+    std::lock_guard<std::mutex> build_guard(g_ob_cuvs_mat_mu);
+    {
+      std::lock_guard<std::mutex> guard(g_ob_cuvs_mu);
+      std::map<void *, ObCuvsEntry *>::iterator it = g_ob_cuvs_reg.find(key);
+      if (it == g_ob_cuvs_reg.end() || it->second == nullptr) {
+        return OB_SUCCESS;
+      }
+      ObCuvsEntry *ent = it->second;
+      if (!ent->vsag_deferred_ || ent->vsag_materialized_ || ent->buf_ids_.empty()) {
+        return OB_SUCCESS;
+      }
+      ent->vsag_materialized_ = true;
+      dim = ent->dim_;
+      vecs = ent->buf_vecs_;
+      ids = ent->buf_ids_;
+    }
+    const int64_t CHUNK = 4096;
+    const int64_t total = static_cast<int64_t>(ids.size());
+    for (int64_t off = 0; OB_SUCC(ret) && off < total; off += CHUNK) {
+      const int64_t n = (off + CHUNK <= total) ? CHUNK : (total - off);
+      vsag::DatasetPtr dataset = vsag::Dataset::Make();
+      dataset->Dim(dim)
+          ->NumElements(n)
+          ->Ids(ids.data() + off)
+          ->Float32Vectors(vecs.data() + off * dim)
+          ->Owner(false);
+      if (OB_FAIL(hnsw->add_index(dataset))) {
+        LOG_WARN("[OBVSAG][cuVS] materialise chunk failed", K(ret), K(off), K(n));
+      }
+    }
+    if (OB_SUCC(ret)) {
+      LOG_INFO("[OBVSAG][cuVS] materialised deferred CPU graph", K(total), K(dim),
+               "index_number", hnsw->get_index_number());
+    }
+  }
+  return ret;
+}
